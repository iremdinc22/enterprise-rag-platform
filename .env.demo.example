# Copy to a NEW private .env.demo only; never overwrite existing environment files.
# Generate a fresh random secret locally. Do not reuse JWT_SECRET_KEY.
DEMO_JWT_SECRET=
DEMO_PORT=18030
DEMO_PROVIDER_MODE=disabled
DEMO_MAX_UPLOAD_BYTES=5242880
DEMO_MAX_PDF_PAGES=10
DEMO_MAX_CHUNKS=200
# No OpenAI key, host service URLs or existing volume names belong here.

# API-only hashes; generate via python -m src.demo.passwords --output .env.demo.auth
# Keep scrypt values single-quoted in dotenv files; never store plaintext passwords.
DEMO_ACME_PASSWORD_HASH=
DEMO_GLOBEX_PASSWORD_HASH=
