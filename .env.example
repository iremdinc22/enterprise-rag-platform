# Copy to .env.compose (ignored). Never copy operational secrets into this file.
OPENAI_API_KEY=
JWT_SECRET_KEY=
# Default 8001; use 18001 alongside the current local API.
API_PORT=8001
APP_IMAGE=enterprise-rag-app:day27
QDRANT_COLLECTION=enterprise_documents
GENERATION_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# Pinned public model revision used by Compose.
RERANKER_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
RAG_TRACING_ENABLED=false
# Mounted read-only at /app/data in both API and worker. Host paths are not task paths.
DOCUMENTS_DIR=./data
# Host Python defaults (Compose overrides these with internal service DNS):
QDRANT_URL=http://localhost:6333
REDIS_CACHE_URL=redis://localhost:6381/2
REDIS_JOBS_URL=redis://localhost:6381/1
CELERY_BROKER_URL=redis://localhost:6381/0
